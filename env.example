# Copy to .env and load manually, or set in system environment (never commit real values).
# 交互生成（推荐）: .\scripts\create-env-interactive.ps1
TG_BOT_TOKEN=
# Comma-separated numeric chat ids (get yours via @userinfobot)
TG_ADMIN_CHAT_IDS=
OPENAI_API_KEY=
# Optional: code workspace root (defaults to directory containing tg_dev_claw.py)
DEVCLAW_WORKSPACE=
OPENAI_MODEL=gpt-4o
# Extra system instructions for DevClaw (optional)
TG_DEVCLAW_SYSTEM_APPEND=

# DevClaw 扩展（可选）
DEVCLAW_ALLOW_SKILL_INSTALL=
DEVCLAW_USE_DOCKER_SANDBOX=
DEVCLAW_DOCKER_IMAGE=python:3.12-slim
DEVCLAW_DOCKER_NETWORK=none

# 生存 / 寄生（CRITICAL 时 reflex 写 CURSOR_OUTBOX.md 并打开寄生）
DEVCLAW_PARASITE_MODE=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=ollama
SURVIVAL_TICK_SEC=60
SURVIVAL_REFLEX_DEBOUNCE_SEC=300
DEVCLAW_JAILBREAK_FAIL_THRESHOLD=5
# OpenAI 调用失败时：额度耗尽自动 run_critical_reflex；429 默认仅优雅退出，设 1 也触发反射
DEVCLAW_REFLEX_DEBOUNCE_SEC=60
DEVCLAW_REFLEX_ON_429=

# TG 意识路由（交易 vs 工程关键词）
TG_CONSCIOUSNESS_ROUTER=1

# TG 自主心跳（默认关；开启后会周期性跑 DevClaw，消耗 API）
TG_AUTONOMOUS_LIFE=
AUTONOMOUS_LIFE_TICK_SEC=600
TG_AUTONOMOUS_MAX_ITERS=12
TG_AUTONOMOUS_DEGRADED_PROMPT=
TG_AUTONOMOUS_COLD_UPLOAD=
TG_AUTONOMOUS_COLD_PATHS=.claw/sessions
TG_AUTONOMOUS_TRADING=
TG_TRADING_HOURS_UTC=
TG_AUTONOMOUS_TRADING_PROMPT=

# 空闲时每 30 分钟自检（默认关；开启会周期性消耗 API）
TG_IDLE_AUTOTICK=
TG_IDLE_AUTOTICK_SEC=1800
TG_IDLE_AUTOTICK_MAX_ITERS=10
TG_IDLE_AUTOTICK_PROMPT=

# --- Ultimate form (opt-in; see skills/ultimate_capabilities/SKILL.md) ---
# Colab: CLI ultimate-colab-bundle (manual upload)
# Cold storage → your Telegram Saved Messages (your bot token + your chat id)
TG_COLD_STORAGE_CHAT_ID=
PROXY_LIST_FILE=
VPN_SWITCH_CMD=
NOMAD_REGISTER_HANDLERS=
NOMAD_GIT_PUSH=
NOMAD_GIT_PUSH_SESSION_MEMORY=
NOMAD_SHUTDOWN_DELAY_SEC=2
NOMAD_ATEXIT_SNAPSHOT=
NOMAD_OPEN_TASKS=
ETH_RPC_URL=
ETH_TREASURY_ADDRESS=

# --- Meta-driving (autonomous_tick / dev_claw --autonomous) ---
META_REFLEX_DEBOUNCE_SEC=120
META_COLAB_ON_DEGRADED=
META_COLAB_PATHS=task_plan.md
META_COLAB_INSTRUCTION=
META_PROXY_ROTATE_ON_NET_PAIN=1
META_OBSERVE_FUNDING=1
META_FUNDING_SYMBOL=BTCUSDT
META_EVOLVE_ON_TICK=
META_EVOLVE_MIN_SEC=3600
# 推理闭环：DEGRADED 或连续失败 ≥N 时向 task_plan.md 追加「假设-验证」模板（debounced）
META_REASONING_EPISODE=
META_REASONING_DEBOUNCE_SEC=7200
META_REASONING_FAIL_THRESHOLD=3
META_NETSH_CMD=
META_QUOTA_LESSON_MIN_SEC=3600
